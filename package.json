{
  "name": "twitter-snap",
  "version": "0.2.1",
  "description": "Create beautiful Tweet images fast",
  "keywords": [
    "twitter",
    "screenshots"
  ],
  "homepage": "https://github.com/fa0311/twitter-snap",
  "bugs": "https://github.com/fa0311/twitter-snap/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fa0311/twitter-snap.git"
  },
  "license": "MIT",
  "author": "ふぁ @fa0311",
  "type": "module",
  "exports": "./dist/main.js",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "bin": {
    "twitter-snap": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "dev": "vite",
    "format": "biome format --write .",
    "lint": "biome check .",
    "postpack": "rimraf oclif.manifest.json",
    "prepack": "oclif manifest && node ./replace.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "version": "node ./replace.js && git add README.md"
  },
  "oclif": {
    "bin": "twitter-snap",
    "dirname": "twitter-snap",
    "default": ".",
    "commands": {
      "strategy": "single",
      "target": "./dist/commands/index.js"
    },
    "hooks": {
      "preparse": "./dist/hooks/interactive.js"
    },
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins",
      "@oclif/plugin-warn-if-update-available"
    ],
    "topicSeparator": " ",
    "topics": {},
    "warn-if-update-available": {
      "message": "Update available! Run npm i -g twitter-snap to update"
    }
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@oclif/core": "^5.1.9",
    "@oclif/plugin-help": "^7.0.5",
    "@oclif/plugin-plugins": "^7.0.13",
    "@oclif/plugin-warn-if-update-available": "^4.0.3",
    "@vercel/og": "^0.11.1",
    "cli-color": "^2.0.4",
    "escape-string-regexp": "^5.0.0",
    "fflate": "^0.8.3",
    "fluent-ffmpeg": "^2.1.3",
    "graphemesplit": "^2.6.0",
    "linebreak": "^1.1.0",
    "log-symbols": "^7.0.1",
    "ora": "^9.4.1",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.16.0",
    "react": "^19.3.1",
    "twitter-openapi-typescript": "^0.1.4",
    "twitter-openapi-typescript-generated": "^0.1.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@hono/react-renderer": "^1.0.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@oclif/test": "^5.0.3",
    "@types/cli-color": "^2.0.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^24.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "hono": "^4.13.13",
    "oclif": "^6.0.8",
    "react-dom": "^19.3.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
